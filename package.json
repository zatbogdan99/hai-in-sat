{
  "name": "hai-in-sat",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "build": "ng build && ng run hai-in-sat:server",
    "build:browser": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:ssr": "tsc -p tsconfig.ssr-test.json && node --test out-tsc/ssr-test/ssr-cache.test.js",
    "test:ssr:http": "node scripts/test-ssr-cache.cjs",
    "dev:ssr": "ng run hai-in-sat:serve-ssr",
    "serve:ssr": "node dist/hai-in-sat/server/main.js",
    "prerender": "ng run hai-in-sat:prerender"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.33",
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/fire": "^20.1.0",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/platform-browser-dynamic": "^20.3.33",
    "@angular/platform-server": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@angular/ssr": "^20.3.37",
    "@fortawesome/angular-fontawesome": "^2.0.1",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@primeuix/themes": "^1.2.5",
    "@videogular/ngx-videogular": "^9.0.0",
    "core-js": "^3.36.0",
    "express": "^4.22.3",
    "firebase": "^11.10.0",
    "gsap": "^3.12.2",
    "lru-cache": "11.5.3",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.1",
    "split-type": "^0.3.3",
    "swiper": "^12.2.0",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.37",
    "@angular/cdk": "^20.2.14",
    "@angular/cli": "~20.3.37",
    "@angular/compiler-cli": "^20.3.33",
    "@types/core-js": "^2.5.8",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^22.0.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sass": "^1.72.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "webpack": "^5.89.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "piscina": "5.3.2",
    "webpack-dev-middleware": "7.4.6"
